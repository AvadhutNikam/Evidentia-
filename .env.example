# ==============================================================================
# EVIDENTIA-AI ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' (or 'backend/.env') and supply your real values.
# NEVER commit or share your '.env' file containing real secrets!

# [REQUIRED] Cryptographically Secure JWT Secret Key
# The backend will strictly refuse to start if this is missing or insecure.
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# [REQUIRED] Google Gemini API Key
# Used for Forensic NLI Evidence Classification and Plain LLM Baseline.
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# [OPTIONAL] Database Connection URL
# SQLite default: sqlite:///evidentia.db
# PostgreSQL example: postgresql://evidentia_user:STRONG_PASSWORD_HERE@localhost:5432/evidentia
DATABASE_URL=sqlite:///evidentia.db

# [CORS SECURITY CONFIGURATION]
# Comma-separated list of permitted frontend origins for Cross-Origin Resource Sharing.
# In production, set this to your deployed frontend domain(s).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://evidentia-ai.vercel.app,https://evidentia-ai.netlify.app

# [FRONTEND CONFIGURATION]
# Single unified API URL for the React application.
# Used across all services, AuthContext, IntelligencePipeline, and AiAssistant.
VITE_API_URL=http://localhost:8000



